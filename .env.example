PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://portfolio:change-this-password@localhost:5432/portfolio
# Use verify-full for a public/external database; internal Docker/Render connections can use disable.
DATABASE_SSL=disable
# Optional path to the provider CA certificate for verify-full.
# DATABASE_CA_FILE=/path/to/ca.pem
# Set to the exact number of reverse proxies in front of Express; Render uses 1.
# TRUST_PROXY_HOPS=1
